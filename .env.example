# FreePDF needs no environment variables to build or run: every Phase 1 tool works offline in the browser.
#
# --- Deployment (GitHub repository secrets / variables, NOT committed) ---
# CLOUDFLARE_API_TOKEN=   # secret: API token with "Cloudflare Pages: Edit" permission
# CLOUDFLARE_ACCOUNT_ID=  # secret: your Cloudflare account ID
# CF_PAGES_PROJECT=freepdf  # optional repository *variable* if your Pages project has another name
#
# --- Local manual deploy ---
# export CLOUDFLARE_API_TOKEN=... CLOUDFLARE_ACCOUNT_ID=...
# npm run build && npx wrangler pages deploy dist --project-name=freepdf
